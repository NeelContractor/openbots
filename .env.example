# Database — local Docker Postgres (docker compose up -d), or your Supabase/Postgres URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/openbots

# Supabase Storage & Services
SUPABASE_URL=
# Service role key (required on server/backend for admin storage operations bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Anon key (for public client-side access or user-scoped RLS operations)
SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=conversation-attachments

# Redis (local Docker REST proxy via docker compose, or Upstash)
REDIS_HTTP_TOKEN=local-openbots-token
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-openbots-token

# Composio — external app integrations
COMPOSIO_API_KEY=

# Trigger.dev — background task execution
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Better Auth — authentication
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000

# API server
PORT=3001

# Web app — public, safe for browser
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider keys (at least one is required to chat; Gemini has a free tier)
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Web Push Notifications (VAPID)
VAPID_SUBJECT=mailto:admin@openbots.dev
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
