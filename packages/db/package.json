{
  "name": "@openbots/db",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./redis": "./src/redis/index.ts",
    "./storage": "./src/storage/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun run --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun run --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun run --env-file=../../.env drizzle-kit push",
    "db:studio": "bun run --env-file=../../.env drizzle-kit studio"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@supabase/storage-js": "^2.117.3",
    "@supabase/supabase-js": "^2.117.3",
    "@upstash/redis": "^1.39.0",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  }
}
